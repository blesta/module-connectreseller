<?php /** @var View $this **/ ?>

<?php
$this->Form->create();

foreach ($whois_fields ?? [] as $name => $field) {
    if ($field['type'] == 'hidden') {
        call_user_func_array([$this->Form, $field['type']], [$name, $vars->{$name} ?? ($field['options'] ?? '')]);
    }
}

$i = 0;
foreach ($sections ?? [] as $index => $key) { ?>
    <h6 class="form-section-header"><?php $this->_('Connectreseller.tab_whois.section_' . $key); ?></h6>
    <?php foreach ($whois_fields ?? [] as $name => $field) { ?>
        <div class="mb-3">
            <?php
            $this->Form->label($field['label'], $name, ['class' => 'form-label']);
            $this->Form->fieldText($key . '[' . $name . ']', $vars->{$key}[$name] ?? '', [
                'id' => $name,
                'class' => 'form-control',
                'placeholder' => $field['label'],
            ]);
            ?>
        </div>
    <?php } ?>
<?php }
?>

<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit(null, $this->_('Connectreseller.tab_whois.field_submit', true), [
        'class' => 'btn btn-primary'
    ]); ?>
</div>

<?php $this->Form->end(); ?>
