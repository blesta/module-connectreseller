<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Connectreseller.tab_dns.title_list'); ?></h6>
<div class="mb-3">
    <table class="table table-striped">
        <thead>
            <tr>
                <th><?php $this->_('Connectreseller.tab_dns.record_type'); ?></th>
                <th><?php $this->_('Connectreseller.tab_dns.host'); ?></th>
                <th><?php $this->_('Connectreseller.tab_dns.value'); ?></th>
                <th><?php $this->_('Connectreseller.tab_dns.ttl'); ?></th>
                <th><?php $this->_('Connectreseller.tab_dns.field_delete'); ?></th>
            </tr>
        </thead>

        <tbody>
            <?php if (is_array($dns_records ?? []) && !empty($dns_records ?? [])) {
                foreach ($dns_records as $record) { ?>
            <tr>
                <td><?php echo $record->recordType ?? null; ?></td>
                <td><?php echo $record->recordName ?? null; ?></td>
                <td style="max-width: 200px; overflow: hidden;"><?php echo $record->recordContent ?? null; ?></td>
                <td><?php echo $record->recordTTL ?? null; ?></td>
                <td>
                    <?php
                    $this->Form->create();
                    $this->Form->fieldHidden('dnszoneRecordID', $record->dnszoneRecordID ?? null);

                    $this->Form->fieldButton('action', $this->_('Connectreseller.tab_dns.field_delete', true), [
                        'class' => 'btn btn-sm btn-danger',
                        'value' => 'delete',
                        'type' => 'submit',
                    ]);

                    $this->Form->end();
                    ?>
                </td>
            </tr>
                    <?php }
            } ?>
        </tbody>
    </table>
</div>

<?php
$this->Form->create();
?>
<h6 class="form-section-header mt-4"><?php $this->_('Connectreseller.tab_dns.title_add'); ?></h6>
<div class="row">
    <div class="col-md-3">
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Connectreseller.tab_dns.record_type', true), 'record_type', ['class' => 'form-label']);
            $this->Form->fieldSelect('RecordType', $supported_types ?? [], $vars->RecordType ?? null, [
                'id' => 'record_type',
                'class' => 'form-select',
            ]);
            ?>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Connectreseller.tab_dns.host', true), 'host', ['class' => 'form-label']);
            $this->Form->fieldText('RecordName', $vars->RecordName ?? null, [
                'id' => 'host',
                'class' => 'form-control',
            ]);
            ?>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Connectreseller.tab_dns.value', true), 'value', ['class' => 'form-label']);
            $this->Form->fieldText('RecordValue', $vars->RecordValue ?? null, [
                'id' => 'value',
                'class' => 'form-control',
            ]);
            ?>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Connectreseller.tab_dns.ttl', true), 'ttl', ['class' => 'form-label']);
            $this->Form->fieldText('RecordTTL', $vars->RecordTTL ?? 3600, [
                'id' => 'ttl',
                'class' => 'form-control',
            ]);
            ?>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit(null, $this->_('Connectreseller.tab_dns.field_add', true), ['class' => 'btn btn-primary float-end']); ?>
</div>
<?php
$this->Form->end();
?>
