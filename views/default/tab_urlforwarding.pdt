<?php /** @var View $this **/ ?>

<?php
$this->Form->create();
?>
<h6 class="form-section-header"><?php $this->_('Connectreseller.tab_urlforwarding.heading_current_rules'); ?></h6>
<div class="mb-3">
    <table class="table table-striped">
        <thead>
            <tr>
                <th><?php $this->_('Connectreseller.tab_urlforwarding.heading_source'); ?></th>
                <th><?php $this->_('Connectreseller.tab_urlforwarding.heading_destination'); ?></th>
                <th><?php $this->_('Connectreseller.tab_urlforwarding.heading_options'); ?></th>
            </tr>
        </thead>
        <tbody>
            <?php if (!empty($domain_rule->websiteName)) { ?>
            <tr>
                <td><?php echo $this->Html->safe($domain_rule->websiteName); ?></td>
                <td><?php echo $this->Html->safe($domain_rule->rewrite ?? $domain_rule->proxyPass); ?></td>
                <td>
                    <button class="btn btn-sm btn-outline-danger" type="submit" name="delete" title="<?php $this->_('Connectreseller.tab_urlforwarding.option_delete', true); ?>">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
            <?php } else { ?>
            <tr>
                <td colspan="4">
                    <div class="alert alert-info w-100" role="alert">
                        <?php $this->_('Connectreseller.tab_urlforwarding.text_no_forwarding_rules'); ?>
                    </div>
                </td>
            </tr>
            <?php } ?>
        </tbody>
    </table>
</div>

<h6 class="form-section-header mt-4"><?php $this->_('Connectreseller.tab_urlforwarding.heading_add_rule'); ?></h6>
<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <?php
                $this->Form->label(
                    $this->_('Connectreseller.tab_urlforwarding.field_destination', true),
                    'destination',
                );
                $this->Form->fieldText('destination', $vars->destination ?? '', [
                    'id' => 'destination',
                    'class' => 'form-control',
                    'placeholder' => 'http://example.com',
                ]);
                ?>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit(null, $this->_('Connectreseller.tab_urlforwarding.field_submit', true), ['class' => 'btn btn-primary float-end']); ?>
</div>
<?php
$this->Form->end();
?>
